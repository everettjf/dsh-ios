#!/bin/sh
# Launch the DeepSeek Harness web UI inside the DSH iOS app's Linux guest.
#
# The iOS app runs this as the supervised foreground process and points its
# WKWebView at http://127.0.0.1:$DSH_PORT once the server answers.
#
#   DSH_PORT       listen port (default 3080)
#   DSH_WORKSPACE  initial working directory offered as the workspace
#   DSH_HOME       harness home (default /root/.dsh)
export HOME=/root
export DSH_HOME="${DSH_HOME:-/root/.dsh}"
export DSH_WORKSPACE="${DSH_WORKSPACE:-/root/workspace}"
PORT="${DSH_PORT:-3080}"

mkdir -p "$DSH_WORKSPACE"

# Keep the patches this image ships in place. A harness home migrated from an
# older image (see DSHRootUpgrader) carries that image's copies, which would
# silently pin old settings — and would drop plugins this image adds, such as
# the host bridge.
mkdir -p "$DSH_HOME"
install -m 0644 /usr/local/share/dsh/home.patch.yml "$DSH_HOME/cordis.patch.yml"
[ -d "$DSH_HOME/profiles/web" ] && install -m 0644 /usr/local/share/dsh/cordis.patch.yml "$DSH_HOME/profiles/web/cordis.patch.yml"

cd "$DSH_WORKSPACE"

# --expose-internals: cordis-plugin-hmr needs Node internals; the prebuilt
# node-addon-require-builtin shim has no musl build, so use the flag instead.
exec node --expose-internals \
    /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js \
    web --host 127.0.0.1 --port "$PORT" "$@"
